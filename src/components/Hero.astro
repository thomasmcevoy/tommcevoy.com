---
  import { Image } from "astro:assets";
  import headshot from "../assets/images/thomas-l.jpg";
---

<section id="hero-image">
  <Image src={headshot} alt="Headshot of Tom McEvoy" />
</section>

<style>
  #hero-image {
    padding: 0;
    width: 100%;
    height: auto;
  }

  #hero-image img {
    display: block;
    width: 100%;
    height: auto;
    margin: auto;
    object-fit: contain;
  }
</style>